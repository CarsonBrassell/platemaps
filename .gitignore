# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local file-based data store (accounts, sessions, posts)
/data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Raw Overpass response, cached by scripts/fetch-osm-restaurants.mjs so that
# iterating on the matching rules doesn't re-query a volunteer-run public
# endpoint. Regenerable with --refetch, and megabytes of unreviewed API output.
# The reviewed result, osm/san-diego.json, IS committed — same split as menus/.
/osm/overpass-raw.json

# typescript
*.tsbuildinfo
next-env.d.ts

# AI tooling — settings.local.json is machine-specific, and the installed
# skills are regenerable with `npx impeccable install`
/.claude/
